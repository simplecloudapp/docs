  "navbar": {
    "links": [
      {
        "label": "Discord",
        "href": "https://discord.simplecloud.app"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dash.simplecloud.app"
    }
  },
