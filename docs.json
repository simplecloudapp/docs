                "pages": [
                  "en/course/in-depth/self-hosted",
                  "en/course/in-depth/multi-root",
                  "en/course/in-depth/remote-access"
                ]
              },
              {
                "group": "More Guides",
                "pages": [
                  "en/course/guides/linux-essentials",
                  "en/course/guides/permissions"
                ]
              }
            ]
          }
        ]
