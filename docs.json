{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "simplecloud",
  "colors": {
    "primary": "#00BCFF",
    "light": "#00BCFF",
    "dark": "#00BCFF"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#09090B"
    },
    "decoration": "grid"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "languages": [
      {
        "language": "en",
        "tabs": [
          {
            "tab": "Manual",
            "groups": [
              {
                "group": "Introduction",
                "pages": [
                  "en/manual/introduction/overview",
                  {
                    "group": "Architecture",
                    "expanded": false,
                    "root": "en/manual/introduction/architecture/overview",
                    "pages": [
                      "en/manual/introduction/architecture/controller",
                      "en/manual/introduction/architecture/serverhost",
                      "en/manual/introduction/architecture/cli"
                    ]
                  },
                  "en/manual/introduction/philosophy",
                  "en/manual/introduction/updates",
                  "en/manual/introduction/faq"
                ]
              },
              {
                "group": "Setup",
                "pages": [
                  "en/manual/setup/installation",
                  "en/manual/setup/server-groups",
                  "en/manual/setup/persistent-servers",
                  "en/manual/setup/servers",
                  "en/manual/setup/templates",
                  "en/manual/setup/multi-root",
                  "en/manual/setup/self-hosting"
                ]
              },
              {
                "group": "Configuration",
                "pages": [
                  "en/manual/configuration/configurators",
                  "en/manual/configuration/workflows"
                ]
              },
              {
                "group": "Plugins",
                "pages": [
                  "en/manual/plugin/overview",
                  "en/manual/plugin/server-registration",
                  "en/manual/plugin/server-connection",
                  "en/manual/plugin/cloud-command",
                  "en/manual/plugin/proxy-essentials",
                  "en/manual/plugin/notify",
                  "en/manual/plugin/prefixes",
                  "en/manual/plugin/signs",
                  "en/manual/plugin/npcs",
                  "en/manual/plugin/placeholders"
                ]
              }
            ]
          },
          {
            "tab": "Developer",
            "groups": [
              {
                "group": "Getting Started",
                "pages": [
                  "en/developer/overview",
                  "en/developer/installation"
                ]
              },
              {
                "group": "Cloud API",
                "pages": [
                  "en/developer/api/groups",
                  "en/developer/api/servers",
                  "en/developer/api/players",
                  "en/developer/api/events"
                ]
              },
              {
                "group": "Guides",
                "pages": [
                  "en/developer/guides/player-transfer",
                  "en/developer/guides/server-management",
                  "en/developer/guides/event-handling"
                ]
              },
              {
                "group": "REST API Reference",
                "openapi": {
                  "source": "https://controller.platform.simplecloud.app/swagger/doc.json",
                  "directory": "en/developer/api-reference"
                }
              }
            ]
          },
          {
            "tab": "Changelogs",
            "groups": [
              {
                "group": "Releases",
                "pages": [
                  "en/changelogs/platform",
                  "en/changelogs/plugins"
                ]
              }
            ]
          }
        ]
      },
      {
