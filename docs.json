{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "simplecloud",
  "colors": {
    "primary": "#00BCFF",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "languages": [
      {
        "language": "en",
        "tabs": [
          {
            "tab": "Manual",
            "groups": [
              {
                "group": "Introduction",
                "pages": [
                  "en/manual/introduction/overview",
                  "en/manual/introduction/philosophy",
                  "en/manual/introduction/updates",
                  "en/manual/introduction/faq"
                ]
              },
              {
                "group": "Setup",
                "pages": [
                  "en/manual/setup/installation",
                  "en/manual/setup/dashboard",
                  "en/manual/setup/groups",
                  "en/manual/setup/servers",
                  "en/manual/setup/templates"
                ]
              },
              {
                "group": "Droplets",
                "pages": [
                  "en/manual/droplet/overview",
                  "en/manual/droplet/player",
                  "en/manual/droplet/resourcepack"
                ]
              },
              {
                "group": "Plugins",
                "pages": [
                  "en/manual/plugin/overview",
                  "en/manual/plugin/server-connection",
                  "en/manual/plugin/cloud-command",
                  "en/manual/plugin/proxy-essentials",
                  "en/manual/plugin/notify",
                  "en/manual/plugin/prefixes",
                  "en/manual/plugin/signs",
                  "en/manual/plugin/npcs",
                  "en/manual/plugin/placeholders"
                ]
              },
              {
                "group": "Guides",
                "pages": [
                  "en/manual/guide/permissions",
                  "en/manual/guide/testimonials",
                  "en/manual/guide/remote-access",
                  "en/manual/guide/multi-root",
                  "en/manual/guide/self-hosted-dashboard"
                ]
              }
            ]
          },
          {
            "tab": "Concepts",
            "groups": [
              {
                "group": "Core Concepts",
                "pages": [
                  "en/concepts/overview"
                ]
              }
            ]
          },
          {
            "tab": "Developer",
            "groups": [
              {
                "group": "Developer Guide",
                "pages": [
                  "en/developer/overview"
                ]
              }
            ]
          }
        ]
      },
      {
        "language": "de",
        "tabs": [
          {
            "tab": "Manual",
            "groups": [
              {
                "group": "Introduction",
                "pages": [
                  "de/manual/introduction/overview",
