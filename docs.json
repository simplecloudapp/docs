                "pages": [
                  "de/manual/droplet/overview",
                  "de/manual/droplet/player",
                  "de/manual/droplet/resourcepack"
                ]
              },
              {
                "group": "Plugins",
                "pages": [
                  "de/manual/plugin/overview",
                  "de/manual/plugin/server-connection",
                  "de/manual/plugin/cloud-command",
                  "de/manual/plugin/proxy-essentials",
                  "de/manual/plugin/notify",
