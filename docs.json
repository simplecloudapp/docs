{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "simplecloud",
  "colors": {
    "primary": "#00BCFF",
    "light": "#00BCFF",
    "dark": "#00BCFF"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#09090B"
    },
    "decoration": "grid"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "languages": [
      {
        "language": "en",
        "tabs": [
          {
            "tab": "Manual",
            "groups": [
              {
                "group": "Introduction",
                "pages": [
                  "en/manual/introduction/overview",
                  "en/manual/introduction/philosophy",
                  "en/manual/introduction/updates",
                  "en/manual/introduction/faq"
                ]
              },
              {
                "group": "Setup",
                "pages": [
                  "en/manual/setup/installation",
                  "en/manual/setup/groups",
                  "en/manual/setup/persistent-servers",
                  "en/manual/setup/servers",
                  "en/manual/setup/templates",
                  "en/manual/setup/multi-root"
                ]
              },
              {
                "group": "Configuration",
                "pages": [
                  "en/manual/configuration/configurators",
                  "en/manual/configuration/workflows"
                ]
              },
              {
                "group": "Droplets",
                "pages": [
                  "en/manual/droplet/overview",
                  "en/manual/droplet/player",
                  "en/manual/droplet/resourcepack"
                ]
              },
              {
                "group": "Plugins",
                "pages": [
                  "en/manual/plugin/overview",
                  "en/manual/plugin/server-registration",
                  "en/manual/plugin/server-connection",
                  "en/manual/plugin/cloud-command",
                  "en/manual/plugin/proxy-essentials",
                  "en/manual/plugin/notify",
                  "en/manual/plugin/prefixes",
                  "en/manual/plugin/signs",
                  "en/manual/plugin/npcs",
                  "en/manual/plugin/placeholders"
                ]
              },
              {
                "group": "Guides",
                "pages": [
                  "en/manual/guide/permissions",
                  "en/manual/guide/testimonials",
                  "en/manual/guide/remote-access",
                  "en/manual/guide/self-hosted-dashboard"
                ]
              },
              {
                "group": "Architecture",
                "expanded": false,
                "pages": [
                  "en/manual/architecture/overview",
                  "en/manual/architecture/controller",
                  "en/manual/architecture/serverhost",
                  "en/manual/architecture/cli"
                ]
              }
            ]
          },
          {
            "tab": "Developer",
            "groups": [
              {
                "group": "Getting Started",
                "pages": ["en/developer/overview", "en/developer/installation"]
              },
              {
                "group": "Cloud API",
                "pages": [
                  "en/developer/api/groups",
                  "en/developer/api/servers",
                  "en/developer/api/players",
                  "en/developer/api/events"
                ]
              },
              {
                "group": "Guides",
                "pages": [
                  "en/developer/guides/player-transfer",
                  "en/developer/guides/server-management",
                  "en/developer/guides/event-handling"
                ]
              },
              {
                "group": "REST API Reference",
                "openapi": {
                  "source": "https://controller.platform.simplecloud.app/swagger/doc.json",
                  "directory": "en/developer/api-reference"
                }
              }
            ]
          },
          {
            "tab": "Course",
            "groups": [
              {
                "group": "Foundations",
                "pages": [
                  "en/course/foundations/introduction",
                  "en/course/foundations/installation",
                  "en/course/foundations/server-groups-and-templates",
                  "en/course/foundations/droplets",
                  "en/course/foundations/plugins"
